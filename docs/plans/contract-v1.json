            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Hours"
        },
        "available_hours_per_week": {
          "anyOf": [
            {
              "maximum": 168,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Hours Per Week"
        },
        "user_judgment": {
          "default": "unknown",
          "enum": [
            "yes",
            "uncertain",
            "no",
            "unknown"
          ],
          "title": "User Judgment",
          "type": "string"
        }
      },
      "required": [
        "goal",
        "completion_criteria",
        "start_at",
        "due_at",
        "timezone"
      ],
      "title": "Card",
      "type": "object"
    },
