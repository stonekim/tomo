      "additionalProperties": false,
      "properties": {
        "goal": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "completion_criteria": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Completion Criteria",
          "type": "string"
        },
        "start_at": {
          "format": "date-time",
          "title": "Start At",
          "type": "string"
