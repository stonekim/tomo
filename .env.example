# Server only; never put secrets into web bundles. The server does not auto-load .env.
TOMO_DATABASE=./data/tomo.sqlite3
TOMO_SESSION_HOURS=24
TOMO_ALLOWED_ORIGINS=
# disabled | mock | real. Real requires explicit HTTPS endpoint, model and key.
TOMO_MODEL_MODE=disabled
TOMO_MODEL_ENDPOINT=
TOMO_MODEL_NAME=
TOMO_MODEL_API_KEY=
TOMO_MODEL_TIMEOUT=20
TOMO_MODEL_ATTEMPTS=2
