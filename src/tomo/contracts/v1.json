{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomo.local/contracts/v1.json",
  "title": "Tomo shared contract v1",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "Credentials": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9_]{3,40}$"
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        }
      },
      "required": [
        "username",
        "password"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "user_id",
        "token",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "SaveCreate": {
      "type": "object",
      "properties": {
        "domain": {
          "enum": [
            "game",
            "plan"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "state": {
          "type": "object"
        }
      },
      "required": [
        "domain",
        "title",
        "state"
      ],
      "additionalProperties": false
    },
    "Save": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "domain": {
          "enum": [
            "game",
            "plan"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schema_version": {
          "const": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "initial_branch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "initial_state": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "domain",
        "title",
        "schema_version",
        "created_at",
        "initial_branch_id",
        "initial_state"
      ],
      "additionalProperties": false
    },
    "EventProposal": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "payload": {
          "type": "object"
        },
        "state": {
          "type": "object"
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      },
      "required": [
        "expected_revision",
        "idempotency_key",
        "type",
        "payload",
        "state",
        "causes"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "origin_branch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "payload": {
          "type": "object"
        },
        "state": {
          "type": "object"
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sequence",
        "origin_branch_id",
        "type",
        "payload",
        "state",
        "causes",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Fork": {
      "type": "object",
      "properties": {
        "at_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "at_sequence",
        "idempotency_key"
      ],
      "additionalProperties": false
    },
    "Branch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "save_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "fork_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "object"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        }
      },
      "required": [
        "id",
        "save_id",
        "parent_id",
        "fork_sequence",
        "revision",
        "state",
        "events"
      ],
      "additionalProperties": false
    },
    "VersionProposal": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "judgment",
            "update",
            "outcome"
          ]
        },
        "content": {
          "type": "object"
        },
        "based_on": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      },
      "required": [
        "expected_revision",
        "idempotency_key",
        "kind",
        "content",
        "based_on"
      ],
      "additionalProperties": false
    },
    "PlanVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "save_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "previous_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "judgment",
            "update",
            "outcome"
          ]
        },
        "content": {
          "type": "object"
        },
        "based_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "save_id",
        "revision",
        "previous_id",
        "kind",
        "content",
        "based_on",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cost",
        "currency"
      ],
      "additionalProperties": false
    },
    "Audit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "save_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "enum": [
            "real",
            "mock"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "status": {
          "enum": [
            "pending",
            "ok",
            "timeout",
            "transport",
            "rate_limited",
            "provider_error",
            "invalid_response"
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "save_id",
        "purpose",
        "mode",
        "model",
        "attempt",
        "status",
        "usage",
        "created_at"
      ],
      "additionalProperties": false
    }
  }
}
